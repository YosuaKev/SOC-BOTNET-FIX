log "Selected capture interface: $SELECTED_INTERFACE (source=$INTERFACE_SOURCE)"

if [[ ${#PROTECTED_IPS[@]} -eq 0 ]]; then
  mapfile -t PROTECTED_IPS < <(
    ip -o -4 addr show dev "$SELECTED_INTERFACE" scope global \
      | awk '{split($4,a,"/"); print a[1]}' \
      | awk '!seen[$0]++'
  )
  [[ ${#PROTECTED_IPS[@]} -gt 0 ]] \
    || die "No global IPv4 address found on $SELECTED_INTERFACE; use --protected-ip IP"
  log "Auto-detected protected destination(s): ${PROTECTED_IPS[*]}"
else
  log "Using protected destination override(s): ${PROTECTED_IPS[*]}"
fi

log "Domain metadata: Zeek http.log host -> ssl.log server_name (TLS SNI)"

# Reverse-proxy/WAF discovery. Manual --trusted-proxy always wins.
if [[ ${#TRUSTED_PROXIES[@]} -eq 0 ]]; then
  APACHECTL=""
  for candidate in apachectl apache2ctl httpd; do
    if command -v "$candidate" >/dev/null 2>&1; then
      APACHECTL="$candidate"
      break
    fi
  done

  if [[ -n "$APACHECTL" ]] && "$APACHECTL" -M 2>/dev/null | grep -qi 'remoteip_module'; then
    REMOTEIP_LINES="$(
      grep -RhiE '^[[:space:]]*RemoteIP(Header|TrustedProxy|InternalProxy)[[:space:]]+' \
        /etc/apache2 /etc/httpd /usr/local/apache/conf 2>/dev/null || true
    )"
    PROXY_HEADER="$(printf '%s\n' "$REMOTEIP_LINES" | awk 'tolower($1)=="remoteipheader" {print $2; exit}')"

    if [[ "${PROXY_HEADER,,}" == "cf-connecting-ip" ]]; then
      PROXY_MODE="cloudflare-apache"
      TRUSTED_PROXY_SOURCE="apache-cloudflare-metadata"
      APACHE_REMOTEIP_CONFIG="CF-Connecting-IP"
      log "Detected Apache mod_remoteip with CF-Connecting-IP (Cloudflare mode)"
      log "Cloudflare CIDRs are not passed to Zeek XFF resolver; HTTPS headers are encrypted on the capture interface"
    elif [[ "${PROXY_HEADER,,}" == "x-forwarded-for" ]]; then
      while read -r token; do
        [[ -n "$token" ]] || continue
        if [[ "$token" != */* ]] && python3 - "$token" <<'PY_ONE_IP' >/dev/null 2>&1
import ipaddress, sys
ipaddress.ip_address(sys.argv[1])
PY_ONE_IP
        then
          TRUSTED_PROXIES+=("$token")
        fi
      done < <(
        printf '%s\n' "$REMOTEIP_LINES" \
          | awk 'tolower($1)=="remoteiptrustedproxy" || tolower($1)=="remoteipinternalproxy" {for(i=2;i<=NF;i++) print $i}'
      )
      if [[ ${#TRUSTED_PROXIES[@]} -gt 0 ]]; then
        PROXY_MODE="xff"
        TRUSTED_PROXY_SOURCE="apache-remoteip-auto"
        log "Auto-detected trusted reverse-proxy IP(s): ${TRUSTED_PROXIES[*]}"
      fi
    fi
  fi
fi

if [[ ${#TRUSTED_PROXIES[@]} -gt 0 && "$TRUSTED_PROXY_SOURCE" == "manual" ]]; then
  PROXY_MODE="xff"
fi

python3 - "${TRUSTED_PROXIES[@]}" <<'PY_PROXY'
import ipaddress, sys
for value in sys.argv[1:]:
    ipaddress.ip_address(value)
print("Trusted proxy validation: OK")
PY_PROXY

python3 - "${PROTECTED_IPS[@]}" <<'PY_PROTECTED'
import ipaddress, sys
for value in sys.argv[1:]:
    ipaddress.ip_address(value)
print("Protected IP validation: OK")
PY_PROTECTED

python3 -m py_compile \
  "$SCRIPT_DIR/payload/src/detector.py" \
  "$SCRIPT_DIR/payload/src/behavior_detector.py"

grep -q 'BOTNET_PACKET_THRESHOLD = 50' "$SCRIPT_DIR/payload/src/detector.py" \
  || die "Unified detector payload is not the 50-packet version"
grep -q 'BOTNET_PACKET_WINDOW_SECONDS = 1.0' "$SCRIPT_DIR/payload/src/detector.py" \
  || die "Unified detector payload is not the 1-second window version"
grep -q 'ATTACK_IDLE_TIMEOUT = 3.0' "$SCRIPT_DIR/payload/src/detector.py" \
  || die "Unified detector payload is missing the 3-second idle timeout"
grep -q 'ATTACK_MAX_DURATION = 60.0' "$SCRIPT_DIR/payload/src/detector.py" \
  || die "Unified detector payload is missing the 60-second max session duration"
grep -q -- '--protected-ip' "$SCRIPT_DIR/payload/src/detector.py" \
  || die "Unified detector payload is missing dynamic protected-IP support"
grep -q -- '--ssl-log' "$SCRIPT_DIR/payload/src/detector.py" \
  || die "Unified detector payload is missing TLS SNI domain support"
if grep -q 'WEB_DESTINATIONS = {"' "$SCRIPT_DIR/payload/src/detector.py"; then
  die "Unified detector payload still hard-codes a protected destination"
fi
if grep -q 'write_json_line(DETECTION_LOG' "$SCRIPT_DIR/payload/src/detector.py"; then
  die "Unified payload still persists detections.jsonl"
fi

if [[ "$INTERFACE_SOURCE" != "manual" ]]; then
  BASE_ARGS+=(--interface "$SELECTED_INTERFACE")
fi

# The historical base installer can install uv into a temporary HOME and then
# immediately fail to find it. Install/verify uv at a stable system path before
# invoking the base installer so its own uv check succeeds on Alma/RHEL/Debian.
ensure_uv_runtime() {
  export PATH="/usr/local/bin:$PATH"

  if command -v uv >/dev/null 2>&1; then
    log "uv runtime already available: $(command -v uv) ($(uv --version 2>/dev/null || true))"
    return 0
  fi

  command -v curl >/dev/null 2>&1 \
    || die "curl is required to install uv"

  log "Installing uv to stable system path: /usr/local/bin"
  if ! curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_UNMANAGED_INSTALL=/usr/local/bin UV_NO_MODIFY_PATH=1 sh; then
    die "uv installation failed"
  fi

  [[ -x /usr/local/bin/uv ]] \
    || die "uv installer completed but /usr/local/bin/uv was not created"

  hash -r 2>/dev/null || true
  command -v uv >/dev/null 2>&1 \
    || die "uv exists at /usr/local/bin/uv but is not discoverable in PATH"

  log "uv runtime ready: $(command -v uv) ($(uv --version))"
}

ensure_uv_runtime

log "[1/4] Running base installer"
set +e
(
  cd "$SCRIPT_DIR"
  "$BASE_INSTALL" "${BASE_ARGS[@]}"
)
BASE_RC=$?
set -e

if [[ "$BASE_RC" -ne 0 ]]; then
  log "Base installer returned status $BASE_RC; checking whether core deployment completed so unified finalization can recover it"
fi

# The historical base installer can exit while starting the ML service before
# the unified --protected-ip override is written. Continue only when all core
# deployment artifacts exist; otherwise treat the base failure as real.
[[ -r "$RUNTIME_CONF" ]] || die "Runtime config not found after base install: $RUNTIME_CONF"
# shellcheck disable=SC1090
source "$RUNTIME_CONF"

INSTALL_DIR="${INSTALL_DIR:-/opt/zeek-botnet-detector}"
CONN_LOG="${CONN_LOG:-/var/log/zeek/logs/current/conn.log}"
HTTP_LOG="${HTTP_LOG:-/var/log/zeek/logs/current/http.log}"
SSL_LOG="${SSL_LOG:-/var/log/zeek/logs/current/ssl.log}"

[[ -x "$INSTALL_DIR/venv/bin/python" ]] || die "Detector Python missing: $INSTALL_DIR/venv/bin/python"
[[ -f "$INSTALL_DIR/src/detector.py" ]] || die "Deployed detector.py missing"
[[ -f "$INSTALL_DIR/src/behavior_detector.py" ]] || die "Deployed behavior_detector.py missing"
[[ -f /etc/systemd/system/zeek-botnet-detector.service ]] || die "ML service unit missing after base install"
[[ -f /etc/systemd/system/zeek-behavior-detector.service ]] || die "Behavior service unit missing after base install"

proxy_args=()
for proxy in "${TRUSTED_PROXIES[@]}"; do
  proxy_args+=(--trusted-proxy "$proxy")
done

protected_args=()
for protected_ip in "${PROTECTED_IPS[@]}"; do
  protected_args+=(--protected-ip "$protected_ip")
done

ignore_args=()
if [[ -n "${IGNORE_SERVICES:-}" ]]; then
  read -r -a _ignored <<< "$IGNORE_SERVICES"
  for svc in "${_ignored[@]}"; do
    [[ -n "$svc" ]] && ignore_args+=(--ignore-service "$svc")
  done
fi

quote_cmd() {
  local out="" arg q
  for arg in "$@"; do
    printf -v q '%q' "$arg"
    out+="${out:+ }$q"
  done
  printf '%s' "$out"
}

ML_CMD=(
  "$INSTALL_DIR/venv/bin/python"
  "$INSTALL_DIR/src/detector.py"
  --conn-log "$CONN_LOG"
  --http-log "$HTTP_LOG"
  --ssl-log "$SSL_LOG"
  "${protected_args[@]}"
  "${proxy_args[@]}"
  "${ignore_args[@]}"
)

BEHAVIOR_CMD=(
  "$INSTALL_DIR/venv/bin/python"
  "$INSTALL_DIR/src/behavior_detector.py"
  --http-log "$HTTP_LOG"
  --conn-log "$CONN_LOG"
  --alert-log "$INSTALL_DIR/logs/behavior_alerts.jsonl"
  --window "${BEHAVIOR_WINDOW:-60}"
  --http-threshold "${HTTP_THRESHOLD:-20}"
  --ssh-threshold "${SSH_THRESHOLD:-10}"
  --port-threshold "${PORT_THRESHOLD:-15}"
  --host-threshold "${HOST_THRESHOLD:-15}"
  --flood-window "${FLOOD_WINDOW:-10}"
  --flood-threshold "${FLOOD_THRESHOLD:-100}"
  --beacon-window "${BEACON_WINDOW:-600}"
  --beacon-min-connections "${BEACON_MIN_CONNECTIONS:-6}"
  --beacon-min-interval "${BEACON_MIN_INTERVAL:-5}"
  --beacon-max-interval "${BEACON_MAX_INTERVAL:-300}"
  --beacon-max-cv "${BEACON_MAX_CV:-0.15}"
  --cooldown "${BEHAVIOR_COOLDOWN:-60}"
  "${proxy_args[@]}"
  "${ignore_args[@]}"
)

log "[2/4] Applying protected-IP/domain runtime services"
mkdir -p \
  /etc/systemd/system/zeek-botnet-detector.service.d \
  /etc/systemd/system/zeek-behavior-detector.service.d

cat > /etc/systemd/system/zeek-botnet-detector.service.d/20-unified.conf <<EOF_ML
[Service]
ExecStart=
ExecStart=$(quote_cmd "${ML_CMD[@]}")
EOF_ML

cat > /etc/systemd/system/zeek-behavior-detector.service.d/20-unified.conf <<EOF_BEHAVIOR
[Service]
ExecStart=
ExecStart=$(quote_cmd "${BEHAVIOR_CMD[@]}")
EOF_BEHAVIOR

set_runtime_value() {
  local key="$1" value="$2"
  if grep -q "^${key}=" "$RUNTIME_CONF"; then
    sed -i "s|^${key}=.*|${key}='${value}'|" "$RUNTIME_CONF"
  else
    printf "%s='%s'\n" "$key" "$value" >> "$RUNTIME_CONF"
  fi
}

set_runtime_value TRUSTED_PROXIES "${TRUSTED_PROXIES[*]}"
set_runtime_value TRUSTED_PROXY_SOURCE "$TRUSTED_PROXY_SOURCE"
set_runtime_value PROXY_MODE "$PROXY_MODE"
set_runtime_value PROXY_HEADER "$PROXY_HEADER"
set_runtime_value PROTECTED_INTERFACE "$SELECTED_INTERFACE"
set_runtime_value PROTECTED_INTERFACE_SOURCE "$INTERFACE_SOURCE"
set_runtime_value PROTECTED_IPS "${PROTECTED_IPS[*]}"
set_runtime_value SSL_LOG "$SSL_LOG"
set_runtime_value DOMAIN_CORRELATION_MODE "zeek_http_host_then_tls_sni"

systemctl daemon-reload
systemctl enable zeek-botnet-detector.service zeek-behavior-detector.service >/dev/null
systemctl restart zeek-botnet-detector.service zeek-behavior-detector.service
sleep 2

systemctl is-active --quiet zeek-botnet-detector.service \
  || { journalctl -u zeek-botnet-detector.service -n 80 --no-pager; die "ML detector failed"; }
systemctl is-active --quiet zeek-behavior-detector.service \
  || { journalctl -u zeek-behavior-detector.service -n 80 --no-pager; die "Behavior detector failed"; }

log "[3/4] Configuring dedicated Filebeat"
if [[ "$SKIP_FILEBEAT" -eq 0 ]]; then
  FILEBEAT_BIN="$(command -v filebeat || true)"
  [[ -n "$FILEBEAT_BIN" ]] || die "filebeat command not found after base installation"

  # Stop only the dedicated instance before refreshing its isolated config/keystore.
  # The system-wide filebeat.service is intentionally left untouched.
  systemctl stop filebeat-botnet.service 2>/dev/null || true
  mkdir -p /etc/filebeat-botnet /var/lib/filebeat-botnet /var/log/filebeat-botnet

  cat > /etc/filebeat-botnet/filebeat.yml <<EOF_FILEBEAT
filebeat.inputs:
  - type: filestream
    id: zeek-botnet-alerts
    enabled: true
    paths:
      - $INSTALL_DIR/logs/botnet_alerts.jsonl
    parsers:
      - ndjson:
          target: ""
          add_error_key: true
    fields:
      soc_stream: botnet_alert
    fields_under_root: true

  - type: filestream
    id: zeek-behavior-alerts
    enabled: true
    paths:
      - $INSTALL_DIR/logs/behavior_alerts.jsonl
    parsers:
      - ndjson:
          target: ""
          add_error_key: true
    fields:
      soc_stream: behavior_alert
    fields_under_root: true

processors:
  - add_host_metadata: ~

setup.ilm.enabled: false
setup.template.enabled: false

output.elasticsearch:
  hosts:
    - "$ES_HOST"
  username: "$ES_USER"
  password: "\${ES_PASSWORD}"
  ssl.verification_mode: none
  indices:
    - index: "capstone-zeek-botnet-alerts-%{+yyyy.MM.dd}"
      when.equals:
        soc_stream: "botnet_alert"
    - index: "capstone-zeek-behavior-alerts-%{+yyyy.MM.dd}"
      when.equals:
        soc_stream: "behavior_alert"

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat-botnet
  name: filebeat
  keepfiles: 7
  permissions: 0640
EOF_FILEBEAT
  chmod 600 /etc/filebeat-botnet/filebeat.yml

  "$FILEBEAT_BIN" keystore create --force \
    --path.home /usr/share/filebeat \
    --path.config /etc/filebeat-botnet \
    --path.data /var/lib/filebeat-botnet >/dev/null

  "$FILEBEAT_BIN" keystore add ES_PASSWORD --stdin --force \
    --path.home /usr/share/filebeat \
    --path.config /etc/filebeat-botnet \
    --path.data /var/lib/filebeat-botnet \
    < "$ES_PASSWORD_FILE" >/dev/null

  "$FILEBEAT_BIN" test config \
    -c /etc/filebeat-botnet/filebeat.yml \
    --path.home /usr/share/filebeat \
    --path.config /etc/filebeat-botnet \
    --path.data /var/lib/filebeat-botnet >/dev/null \
    || die "Dedicated Filebeat configuration test failed"

  "$FILEBEAT_BIN" test output \
    -c /etc/filebeat-botnet/filebeat.yml \
    --path.home /usr/share/filebeat \
    --path.config /etc/filebeat-botnet \
    --path.data /var/lib/filebeat-botnet \
    || die "Cannot connect dedicated Filebeat to Elasticsearch"

  cat > /etc/systemd/system/filebeat-botnet.service <<EOF_SERVICE
[Unit]
Description=Dedicated Filebeat for Zeek Botnet and Behavior Alerts
Wants=network-online.target
After=network-online.target zeek-botnet-detector.service zeek-behavior-detector.service

[Service]
Type=simple
User=root
Group=root
ExecStart=$FILEBEAT_BIN -e -c /etc/filebeat-botnet/filebeat.yml --path.home /usr/share/filebeat --path.config /etc/filebeat-botnet --path.data /var/lib/filebeat-botnet --path.logs /var/log/filebeat-botnet
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF_SERVICE

  systemctl daemon-reload
  systemctl enable --now filebeat-botnet.service >/dev/null
  sleep 1
  systemctl is-active --quiet filebeat-botnet.service \
    || { journalctl -u filebeat-botnet.service -n 80 --no-pager; die "Dedicated Filebeat failed"; }
else
  log "Dedicated Filebeat skipped by request"
fi

log "[4/4] Final verification"
if grep -q 'write_json_line(DETECTION_LOG' "$INSTALL_DIR/src/detector.py"; then
  die "Deployed detector still writes detections.jsonl"
fi

if [[ "$PURGE_PREDICTIONS" -eq 1 ]]; then
  mkdir -p "$INSTALL_DIR/logs"
  touch "$INSTALL_DIR/logs/detections.jsonl"
  truncate -s 0 "$INSTALL_DIR/logs/detections.jsonl"
  log "Old detections.jsonl truncated by request"
else
  log "Old detections.jsonl preserved; it will no longer grow in unified mode"
fi

if [[ "$BASE_RC" -ne 0 ]]; then
  log "Base-installer status $BASE_RC was recovered successfully by unified finalization"
fi

log "============================================================"
log "SOC-BOTNET Unified installation COMPLETE"
log "Capture interface     : $SELECTED_INTERFACE ($INTERFACE_SOURCE)"
log "Protected destination : ${PROTECTED_IPS[*]}"
log "Proxy mode            : $PROXY_MODE"
log "Trusted proxy         : ${TRUSTED_PROXIES[*]:-none}"
log "Domain correlation    : Zeek HTTP Host -> TLS SNI -> unresolved"
log "ML confirmation       : >=50 RF-positive packets / rolling 1s"
log "Session close         : idle 3s or maximum 60s"
log "ML service            : active"
log "Behavior service      : active"
if [[ "$SKIP_FILEBEAT" -eq 0 ]]; then
  log "Dedicated Filebeat    : active -> $ES_HOST"
  log "Elasticsearch secret  : stored in Filebeat keystore"
fi
log "Main filebeat.service : left untouched"
log "Run verification      : sudo ./verify.sh"
log "============================================================"

INSTALLER
chmod +x "$OUTPUT_REPO/install.sh"

cat > "$OUTPUT_REPO/verify.sh" <<'VERIFY'
#!/usr/bin/env bash
set -u
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="/opt/zeek-botnet-detector"
RUNTIME_CONF="/etc/zeek-botnet-detector.conf"
FAIL=0
ok() { printf '[OK] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*"; }
fail() { printf '[FAIL] %s\n' "$*"; FAIL=$((FAIL+1)); }

if [[ -x "$SCRIPT_DIR/verify-base.sh" ]]; then
  "$SCRIPT_DIR/verify-base.sh" || FAIL=$((FAIL+1))
fi

echo "============================================================"
echo " SOC-BOTNET unified v1.7.3 checks"
echo "============================================================"

D="$INSTALL_DIR/src/detector.py"
B="$INSTALL_DIR/src/behavior_detector.py"

[[ -f "$D" ]] || fail "detector.py missing"
[[ -f "$B" ]] || fail "behavior_detector.py missing"

if [[ -f "$D" ]]; then
  grep -q 'BOTNET_PACKET_THRESHOLD = 50' "$D" && ok "50-packet RF-positive confirmation threshold" || fail "50-packet threshold missing"
  grep -q 'BOTNET_PACKET_WINDOW_SECONDS = 1.0' "$D" && ok "1-second rolling window" || fail "1-second window missing"
  grep -q 'ATTACK_IDLE_TIMEOUT = 3.0' "$D" && ok "3-second attack-session idle timeout" || fail "idle timeout missing"
  grep -q 'ATTACK_MAX_DURATION = 60.0' "$D" && ok "60-second maximum attack-session duration" || fail "max session duration missing"
  grep -q 'def update_attack_session' "$D" && ok "RF attack-session tracker present" || fail "attack-session tracker missing"
  grep -q 'def close_attack_session' "$D" && ok "Final session summary present" || fail "session finalizer missing"
  grep -q -- '--protected-ip' "$D" && ok "Dynamic protected destination CLI present" || fail "--protected-ip missing"
  grep -q 'class XffResolver' "$D" && ok "RF detector XFF resolver present" || fail "RF XFF resolver missing"
  grep -q 'total_observed_packets' "$D" && ok "Final packet totals present" || fail "final packet totals missing"
  if grep -q 'WEB_DESTINATIONS = {"' "$D"; then
    fail "detector.py still hard-codes a protected destination IP"
  else
    ok "No hard-coded protected destination IP"
  fi
  if grep -q 'write_json_line(DETECTION_LOG' "$D"; then
    fail "detector.py still persists intermediate detections.jsonl"
  else
    ok "Final-session-only ML storage enabled"
  fi
fi

if [[ -f "$B" ]]; then
  grep -q 'X-FORWARDED-FOR' "$B" && ok "Behavior detector XFF support present" || fail "Behavior XFF support missing"
  grep -q -- '--trusted-proxy' "$B" && ok "Behavior trusted-proxy CLI present" || fail "Behavior trusted-proxy CLI missing"
fi

ML_UNIT="$(systemctl cat zeek-botnet-detector.service 2>/dev/null || true)"
BEHAVIOR_UNIT="$(systemctl cat zeek-behavior-detector.service 2>/dev/null || true)"

if grep -q -- '--protected-ip' <<< "$ML_UNIT"; then
  ok "ML service receives protected destination configuration"
else
  fail "ML service has no --protected-ip argument"
fi

if grep -q -- '--ssl-log' <<< "$ML_UNIT"; then
  ok "ML service receives Zeek ssl.log for TLS SNI domain correlation"
else
  fail "ML service has no --ssl-log argument"
fi

RUNTIME_PROXY_MODE=""
RUNTIME_TRUSTED_PROXIES=""
if [[ -r "$RUNTIME_CONF" ]]; then
  # shellcheck disable=SC1090
  source "$RUNTIME_CONF"
  RUNTIME_PROXY_MODE="${PROXY_MODE:-direct}"
  RUNTIME_TRUSTED_PROXIES="${TRUSTED_PROXIES:-}"
fi

if [[ -n "$RUNTIME_TRUSTED_PROXIES" ]]; then
  if grep -q -- '--trusted-proxy' <<< "$ML_UNIT"; then
    ok "ML service receives trusted proxy configuration"
  else
    fail "Runtime has trusted proxies but ML service has no --trusted-proxy argument"
  fi
  if grep -q -- '--trusted-proxy' <<< "$BEHAVIOR_UNIT"; then
    ok "Behavior service receives trusted proxy configuration"
  else
    fail "Runtime has trusted proxies but Behavior service has no --trusted-proxy argument"
  fi
else
  ok "No trusted proxy argument required (proxy mode: ${RUNTIME_PROXY_MODE:-direct})"
fi

if [[ -r "$RUNTIME_CONF" ]]; then
  grep -q '^PROTECTED_INTERFACE=' "$RUNTIME_CONF" && ok "Protected interface recorded" || fail "Protected interface not recorded"
  grep -q '^PROTECTED_IPS=' "$RUNTIME_CONF" && ok "Protected IP(s) recorded" || fail "Protected IP(s) not recorded"
else
  fail "Runtime configuration missing: $RUNTIME_CONF"
fi

if systemctl is-active --quiet zeek-botnet-detector.service; then ok "zeek-botnet-detector.service active"; else fail "ML service inactive"; fi
if systemctl is-active --quiet zeek-behavior-detector.service; then ok "zeek-behavior-detector.service active"; else fail "Behavior service inactive"; fi

if [[ -f /etc/filebeat-botnet/filebeat.yml ]]; then
  if grep -q 'botnet_alerts.jsonl' /etc/filebeat-botnet/filebeat.yml; then ok "Dedicated Filebeat ships final botnet alerts"; else fail "botnet alert input missing from Filebeat"; fi
  if grep -q 'detections.jsonl' /etc/filebeat-botnet/filebeat.yml; then
    fail "Dedicated Filebeat still ships detections.jsonl"
  else
    ok "Dedicated Filebeat does not ship intermediate predictions"
  fi
  if grep -q '\${ES_PASSWORD}' /etc/filebeat-botnet/filebeat.yml; then ok "Filebeat YAML references keystore secret"; else fail "Filebeat YAML does not reference ES_PASSWORD keystore key"; fi
  if systemctl is-active --quiet filebeat-botnet.service; then ok "filebeat-botnet.service active"; else fail "Dedicated Filebeat service inactive"; fi
else
  warn "Dedicated Filebeat config absent (possibly installed with --skip-filebeat)"
fi

if [[ "$FAIL" -eq 0 ]]; then
  echo "Unified verification: PASS"
  exit 0
fi

echo "Unified verification: FAIL ($FAIL check(s))"
exit 1
VERIFY
chmod +x "$OUTPUT_REPO/verify.sh"

cat > "$OUTPUT_REPO/VERSION" <<'EOF_VERSION'
1.7.3-unified
EOF_VERSION

cat > "$OUTPUT_REPO/UNIFIED.md" <<'DOC'
# SOC-BOTNET Unified v1.7.3

This repository combines the base SOC-BOTNET installer, the XFF update, and the
latest Random Forest attack-session detector.

## Current ML behavior

- Random Forest threshold: `0.50`.
- Protected destination IP: **not hard-coded** in `detector.py`.
- `install.sh` automatically detects the capture interface (normally from the default route) and then all protected global IPv4 address(es) on that interface.
- Target website metadata is correlated by Zeek UID: `http.log.host` first, then `ssl.log.server_name` (TLS SNI), and the final alert adds only `domain`.
- Optional overrides: `--interface IFACE`, `--protected-ip IP` (repeatable), and `--trusted-proxy IP` (repeatable).
- Confirmation rule: at least `50` RF-positive `orig_pkts` in a rolling `1 second` window.
- Every Zeek connection record continues through Random Forest during the session.
- RF `BOTNET` and `NORMAL` packet totals are tracked separately.
- Session closes after `3 seconds` idle or `60 seconds` maximum duration.
- Only the final CONFIRMED session summary is written to `botnet_alerts.jsonl`.
- `detections.jsonl` is not used for new intermediate predictions.
- X-Forwarded-For is trusted only from configured trusted proxy IPs.

## Automatic domain metadata

Final BOTNET alerts add only `domain` as new target metadata. Existing Filebeat/backend `agent.name` / `host.hostname` / `host.name` / `hostname` metadata is left unchanged for the current Agent column. Domain correlation uses the Zeek connection UID and prefers `http.log.host`; for HTTPS it falls back to `ssl.log.server_name` (TLS SNI). If neither source is available, `domain` remains null rather than being guessed.

## Automatic protected destination

The installer now prompts for the Elasticsearch password interactively by default. The password is hidden while typed and is stored in the dedicated Filebeat keystore, not in `filebeat.yml`. `--es-password-file FILE` remains available for non-interactive deployment.

Normal installation requires no manual destination-IP edit:

```bash
sudo ./install.sh \
  --interface ens160 \
  --skip-zeek-install \
  --trusted-proxy 10.70.184.2 \
  --es-host https://10.70.128.26:9200 \
  --es-user elastic
```

If `ens160` owns `10.70.184.24`, the installer automatically starts the ML service with `--protected-ip 10.70.184.24`.
On another VM, such as `enp0s3` with `10.69.15.127`, it automatically uses `--protected-ip 10.69.15.127`.

Manual override remains available for multi-address/VIP systems:

```bash
sudo ./install.sh \
  --interface ens160 \
  --protected-ip 10.70.184.24 \
  --skip-zeek-install \
  --es-host https://10.70.128.26:9200 \
  --es-user elastic
```

## Final alert fields

The final session JSON includes `domain`, `packets_at_confirmation`, `total_observed_packets`,
`botnet_packets`, `normal_packets`, `botnet_ratio`, record counts, traffic bytes,
`attack_duration_seconds`, and `session_close_reason`. Existing Agent/host fields remain provided by the current Filebeat/backend pipeline.

## Installer reliability fix in v1.7.3

The unified wrapper now pre-installs/validates `uv` at `/usr/local/bin` before the historical base installer runs. This avoids the failure mode where the upstream uv installer places the binary under a temporary HOME (for example `/tmp/.../.local/bin`) and the base installer immediately reports `uv installation failed`. All v1.7.2 protected-IP, domain-correlation, interactive Elasticsearch password, recovery, and dedicated Filebeat behavior is retained.

## Verify

```bash
sudo ./verify.sh
sudo systemctl status zeek-botnet-detector.service --no-pager
sudo journalctl -u zeek-botnet-detector.service -n 30 --no-pager
```

