import sys
import time
from collections import OrderedDict, defaultdict, deque
from datetime import datetime, timezone
from pathlib import Path

import joblib
import numpy as np
from feature_engineering import build_features

BASE_DIR = Path("/opt/zeek-botnet-detector")
MODEL_FILE = BASE_DIR / "models" / "rf_official_bro_final_pipeline.joblib"
CONFIG_FILE = BASE_DIR / "models" / "zeek_official_active_feature_config.pkl"
DETECTION_LOG = BASE_DIR / "logs" / "detections.jsonl"
ALERT_LOG = BASE_DIR / "logs" / "botnet_alerts.jsonl"
THRESHOLD = 0.50
POLL_INTERVAL = 0.25

# Random Forest remains the primary classifier.
#
# Stage 1:
# Every Zeek conn.log record is classified by Random Forest.
#
# Stage 2:
# Only RF-positive records participate in the rolling confirmation rule.
# BOTNET is internally confirmed when >=50 RF-positive orig_pkts are
# observed within a rolling 1-second window.
#
# Stage 3:
# After confirmation, ALL subsequent records in the same traffic session
# continue to pass through Random Forest and are counted separately as
# BOTNET or NORMAL.
#
# Stage 4:
# The final alert is written only when the session becomes idle or reaches
# the maximum session duration.
BOTNET_PACKET_THRESHOLD = 50
BOTNET_PACKET_WINDOW_SECONDS = 1.0

# Session is considered finished after no matching traffic for this period.
ATTACK_IDLE_TIMEOUT = 3.0

# Prevent an endless attack from waiting forever before being reported.
ATTACK_MAX_DURATION = 60.0

# Protected web ports. The protected destination IP is supplied at runtime
# by --protected-ip. The unified installer auto-detects it from the selected
# capture interface, so detector.py contains no hard-coded server IP.
WEB_DESTINATIONS = set()
WEB_PORTS = {80, 443}

# Rolling RF-positive packets used only for BOTNET confirmation.
BOTNET_PACKET_WINDOWS = defaultdict(deque)

# Stateful traffic sessions.
ATTACK_SESSIONS = {}


def safe_int(value, default=-1):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def parse_ignore_service(value):
    value = str(value).strip()
    if value.startswith("["):
        end = value.find("]")
        if end < 0 or end + 1 >= len(value) or value[end + 1] != ":":
            raise ValueError(f"invalid ignored service: {value}")
        host = value[1:end]
        port_text = value[end + 2 :]
    else:
        if ":" not in value:
            raise ValueError(f"ignored service must be HOST:PORT: {value}")
        host, port_text = value.rsplit(":", 1)
    port = int(port_text)
    if not host or not 0 <= port <= 65535:
        raise ValueError(f"invalid ignored service: {value}")
    return host, port


