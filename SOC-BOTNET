model = joblib.load(MODEL_FILE)
config = joblib.load(CONFIG_FILE)
ACTIVE_FEATURES = list(config["active_feature_columns"])
NUMERIC_FEATURES = list(config["active_numeric_features"])
CATEGORICAL_FEATURES = list(config["active_categorical_features"])
assert len(ACTIVE_FEATURES) == 40
preprocessor = model.named_steps["preprocessor"]
assert len(preprocessor.get_feature_names_out()) == 433
classes = np.asarray(model.classes_)
pos = np.where(classes == 1)[0]
if len(pos) != 1:
    raise RuntimeError(f"Unexpected model classes: {classes}")
POSITIVE_INDEX = int(pos[0])

DETECTION_LOG.parent.mkdir(parents=True, exist_ok=True)


def utc_now():
    return datetime.now(timezone.utc).isoformat()


def write_json_line(path, data):
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(data, ensure_ascii=False, separators=(",", ":")) + "\n")
        handle.flush()


def is_ignored_connection(record):
    if not IGNORED_SERVICES:
        return False
    orig = (str(record.get("id.orig_h") or ""), safe_int(record.get("id.orig_p")))
    resp = (str(record.get("id.resp_h") or ""), safe_int(record.get("id.resp_p")))
    return orig in IGNORED_SERVICES or resp in IGNORED_SERVICES



XFF_RE = re.compile(
    r"^\s*X-FORWARDED-FOR\s*->\s*(.+?)\s*$",
    re.IGNORECASE,
)


def normalize_ip(value):
    if value is None:
        return None

    value = str(value).strip()
    if not value:
        return None

    try:
        return str(ipaddress.ip_address(value))
    except ValueError:
        pass

    # Optional IPv4:port representation.
    if value.count(":") == 1:
        host, port = value.rsplit(":", 1)
        if port.isdigit():
            try:
                return str(ipaddress.ip_address(host))
            except ValueError:
                pass

    return None


def parse_xff(event):
    proxied = event.get("proxied") or []
    if isinstance(proxied, str):
        proxied = [proxied]

    chain = []

    for item in proxied:
        match = XFF_RE.match(str(item))
        if not match:
            continue

        for value in match.group(1).split(","):
            ip = normalize_ip(value)
            if ip:
                chain.append(ip)

    return chain


class XffResolver:
    MAX_CACHE = 100000
    INITIAL_SCAN_BYTES = 32 * 1024 * 1024

    def __init__(self, path):
        self.path = Path(path)
        self.handle = None
        self.inode = None
        self.first_open = True
        self.cache = OrderedDict()

    def _remember(self, uid, client_ip, chain):
        if not uid or not client_ip:
            return

        self.cache[uid] = {
            "client_ip": client_ip,
            "xff_chain": chain,
        }
        self.cache.move_to_end(uid)

        while len(self.cache) > self.MAX_CACHE:
            self.cache.popitem(last=False)

    def refresh(self):
        if not self.path.exists():
            return

        try:
            stat = self.path.stat()
        except OSError:
            return

        if self.handle is None or self.inode != stat.st_ino:
            if self.handle is not None:
                try:
                    self.handle.close()
                except Exception:
                    pass

            self.handle = self.path.open(
                "r",
                encoding="utf-8",
                errors="replace",
            )
            self.inode = os.fstat(self.handle.fileno()).st_ino

            if self.first_open and stat.st_size > self.INITIAL_SCAN_BYTES:
                self.handle.seek(stat.st_size - self.INITIAL_SCAN_BYTES)
                self.handle.readline()

            self.first_open = False

        while True:
            line = self.handle.readline()
            if not line:
                break

            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue

            uid = str(event.get("uid") or "")
            observed = normalize_ip(event.get("id.orig_h"))

            # Never trust XFF from an arbitrary Internet host.
            if not uid or observed not in TRUSTED_PROXIES:
                continue

            chain = parse_xff(event)
            if not chain:
                continue

            # Walk right-to-left. Trusted infrastructure is skipped and the
            # first non-trusted address becomes the effective client IP.
            client_ip = None
            for candidate in reversed(chain):
                if candidate not in TRUSTED_PROXIES:
                    client_ip = candidate
                    break

            if client_ip:
                self._remember(uid, client_ip, chain)

    def resolve(self, record):
        observed = normalize_ip(record.get("id.orig_h"))

        if observed not in TRUSTED_PROXIES:
            return None

        self.refresh()

        uid = str(record.get("uid") or "")
        return self.cache.get(uid)


XFF_RESOLVER = XffResolver(HTTP_LOG)


def enrich_source(record, result):
    observed = normalize_ip(record.get("id.orig_h"))

    result["observed_src_ip"] = observed
    result["zeek_src_ip"] = observed
    result["original_src_ip"] = None
    result["source_ip_source"] = "zeek_id.orig_h"
    result["xff_chain"] = []

    resolved = XFF_RESOLVER.resolve(record)

    if resolved:
        result["src_ip"] = resolved["client_ip"]
        result["original_src_ip"] = resolved["client_ip"]
        result["source_ip_source"] = "x_forwarded_for"
        result["xff_chain"] = resolved["xff_chain"]

    return result


def normalize_domain(value):
    if value is None:
        return None

    value = str(value).strip().lower().rstrip(".")
    if not value:
        return None

    # Zeek HTTP host can occasionally include an explicit :port suffix.
    if value.count(":") == 1:
        host, port = value.rsplit(":", 1)
        if port.isdigit():
            value = host.rstrip(".")

    if not value or len(value) > 253:
        return None

    return value


class ZeekUidDomainResolver:
    """Tail a Zeek JSON log and cache one domain-like field by UID."""

    MAX_CACHE = 100000
    INITIAL_SCAN_BYTES = 32 * 1024 * 1024

    def __init__(self, path, field, source):
        self.path = Path(path)
        self.field = field
        self.source = source
        self.handle = None
        self.inode = None
        self.first_open = True
        self.cache = OrderedDict()

    def _remember(self, uid, domain):
        if not uid or not domain:
            return

        self.cache[uid] = {
            "domain": domain,
            "domain_source": self.source,
        }
        self.cache.move_to_end(uid)

        while len(self.cache) > self.MAX_CACHE:
            self.cache.popitem(last=False)

    def refresh(self):
        if not self.path.exists():
            return

        try:
            stat = self.path.stat()
        except OSError:
            return

        if self.handle is None or self.inode != stat.st_ino:
            if self.handle is not None:
                try:
                    self.handle.close()
                except Exception:
                    pass

            self.handle = self.path.open(
                "r",
                encoding="utf-8",
                errors="replace",
            )
            self.inode = os.fstat(self.handle.fileno()).st_ino

            if self.first_open and stat.st_size > self.INITIAL_SCAN_BYTES:
                self.handle.seek(stat.st_size - self.INITIAL_SCAN_BYTES)
                self.handle.readline()

            self.first_open = False

        while True:
            line = self.handle.readline()
            if not line:
                break

            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue

            uid = str(event.get("uid") or "")
            domain = normalize_domain(event.get(self.field))
            if uid and domain:
                self._remember(uid, domain)

    def resolve(self, uid):
        if not uid:
            return None
        self.refresh()
        return self.cache.get(uid)


HTTP_DOMAIN_RESOLVER = ZeekUidDomainResolver(
    HTTP_LOG,
    "host",
    "zeek_http_host",
)

SSL_DOMAIN_RESOLVER = ZeekUidDomainResolver(
    SSL_LOG,
    "server_name",
    "zeek_tls_sni",
)


def enrich_domain(record, result):
    """Attach target website domain using the Zeek UID."""

    result["domain"] = None
    result["domain_source"] = "unresolved"

    uid = str(record.get("uid") or "")
    if not uid:
        return result

    # HTTP Host is preferred; TLS SNI is the HTTPS fallback.
    resolved = HTTP_DOMAIN_RESOLVER.resolve(uid)
    if not resolved:
        resolved = SSL_DOMAIN_RESOLVER.resolve(uid)

    if resolved:
        result["domain"] = resolved["domain"]
        result["domain_source"] = resolved["domain_source"]

    return result


def predict_connection(record):
    X = build_features(
        record=record,
        active_features=ACTIVE_FEATURES,
        numeric_features=NUMERIC_FEATURES,
        categorical_features=CATEGORICAL_FEATURES,
    )
    if list(X.columns) != ACTIVE_FEATURES:
        raise RuntimeError("Feature order mismatch")
    probability = float(model.predict_proba(X)[0][POSITIVE_INDEX])
    prediction = "BOTNET" if probability >= THRESHOLD else "NORMAL"
    return {
        "processed_at_utc": utc_now(),
        "zeek_ts": record.get("ts"),
        "uid": record.get("uid"),
        "src_ip": record.get("id.orig_h"),
        "src_port": record.get("id.orig_p"),
        "dst_ip": record.get("id.resp_h"),
        "dst_port": record.get("id.resp_p"),
        "proto": record.get("proto"),
        "service": record.get("service"),
        "conn_state": record.get("conn_state"),
        "history": record.get("history"),
        "duration": record.get("duration"),
        "orig_bytes": record.get("orig_bytes"),
        "resp_bytes": record.get("resp_bytes"),
        "orig_ip_bytes": record.get("orig_ip_bytes"),
        "resp_ip_bytes": record.get("resp_ip_bytes"),
        "traffic_bytes": (
            safe_int(record.get("orig_ip_bytes"), 0)
            + safe_int(record.get("resp_ip_bytes"), 0)
        ),
        "orig_pkts": record.get("orig_pkts"),
        "resp_pkts": record.get("resp_pkts"),
        "botnet_probability": round(probability, 8),
        "threshold": THRESHOLD,
        "prediction": prediction,
        "detector_mode": "shadow",
    }


def update_attack_session(result):
    """
    Track one traffic session.

    Every record reaching this function has already been classified
    by Random Forest.

    BOTNET records:
      - counted as BOTNET
      - participate in >=50 packets / rolling 1 second confirmation

    NORMAL records:
      - counted as NORMAL
      - do NOT contribute to BOTNET confirmation

    The final alert is NOT written here.
    """

    src_ip = str(result.get("src_ip") or "")
    dst_ip = str(result.get("dst_ip") or "")
    dst_port = safe_int(result.get("dst_port"), 0)

    if not src_ip:
        return None, "missing_source", 0, 0

    if dst_ip not in WEB_DESTINATIONS or dst_port not in WEB_PORTS:
        return None, "non_web", 0, 0

    now = time.time()
    now_utc = utc_now()

    orig_pkts = safe_int(result.get("orig_pkts"), 0)
    if orig_pkts < 0:
        orig_pkts = 0

    traffic_bytes = safe_int(result.get("traffic_bytes"), 0)
    if traffic_bytes < 0:
        traffic_bytes = 0

    # Source port intentionally excluded.
    # A scanner/flooder may continuously change ephemeral source ports.
    key = (src_ip, dst_ip, dst_port)

    session = ATTACK_SESSIONS.get(key)

    if session is None:
        session = {
            "key": key,

            "first_seen_monotonic": now,
            "last_seen_monotonic": now,

            "first_seen_utc": now_utc,
            "last_seen_utc": now_utc,
            "confirmed_at_utc": None,

            "confirmed": False,

            "packets_at_confirmation": 0,
            "records_at_confirmation": 0,

            "total_observed_packets": 0,
            "botnet_packets": 0,
            "normal_packets": 0,

            "total_records": 0,
            "botnet_records": 0,
            "normal_records": 0,

            "total_observed_bytes": 0,
            "botnet_traffic_bytes": 0,
            "normal_traffic_bytes": 0,

            "probability_sum": 0.0,
            "max_botnet_probability": 0.0,

            "domain_packet_counts": {},
            "domain_record_counts": {},
            "domain_sources": {},

            "first_result": dict(result),
            "last_result": dict(result),
        }

        ATTACK_SESSIONS[key] = session

    session["last_seen_monotonic"] = now
    session["last_seen_utc"] = now_utc
    session["last_result"] = dict(result)

    # All records are included in overall traffic statistics.
    session["total_observed_packets"] += orig_pkts
    session["total_observed_bytes"] += traffic_bytes
    session["total_records"] += 1

    domain = normalize_domain(result.get("domain"))
    if domain:
        session["domain_packet_counts"][domain] = (
            session["domain_packet_counts"].get(domain, 0) + orig_pkts
        )
        session["domain_record_counts"][domain] = (
            session["domain_record_counts"].get(domain, 0) + 1
        )
        domain_source = str(result.get("domain_source") or "unresolved")
        previous_source = session["domain_sources"].get(domain)
        if previous_source != "zeek_http_host" or domain_source == "zeek_http_host":
            session["domain_sources"][domain] = domain_source

    probability = float(result.get("botnet_probability") or 0.0)

    session["probability_sum"] += probability

    session["max_botnet_probability"] = max(
        session["max_botnet_probability"],
        probability,
    )

    queue = BOTNET_PACKET_WINDOWS[key]

    cutoff = now - BOTNET_PACKET_WINDOW_SECONDS

    while queue and queue[0][0] < cutoff:
        queue.popleft()

    if result.get("prediction") == "BOTNET":

        session["botnet_packets"] += orig_pkts
        session["botnet_records"] += 1
        session["botnet_traffic_bytes"] += traffic_bytes

        # Only RF-positive packets are allowed to confirm BOTNET.
        queue.append((now, orig_pkts))

    else:

        session["normal_packets"] += orig_pkts
        session["normal_records"] += 1
        session["normal_traffic_bytes"] += traffic_bytes

    # Remove stale rolling-window entries.
    cutoff = now - BOTNET_PACKET_WINDOW_SECONDS

    while queue and queue[0][0] < cutoff:
        queue.popleft()

    window_packets = sum(item[1] for item in queue)
    window_records = len(queue)

    status = "tracking"

    if (
        not session["confirmed"]
        and window_packets >= BOTNET_PACKET_THRESHOLD
    ):
        session["confirmed"] = True
        session["confirmed_at_utc"] = now_utc

        session["packets_at_confirmation"] = int(window_packets)
        session["records_at_confirmation"] = int(window_records)

        status = "confirmed_now"

    return session, status, window_packets, window_records


def close_attack_session(key, reason):
    """
    Close one traffic session.

    Only sessions that previously reached the RF-positive confirmation
    threshold are persisted to botnet_alerts.jsonl.
    """

    session = ATTACK_SESSIONS.pop(key, None)

    BOTNET_PACKET_WINDOWS.pop(key, None)

    if session is None:
        return

    # Normal/unconfirmed traffic must never enter the BOTNET dashboard.
    if not session["confirmed"]:
        return

    result = dict(session["last_result"])

    total_packets = int(session["total_observed_packets"])
    botnet_packets = int(session["botnet_packets"])
    normal_packets = int(session["normal_packets"])

    total_records = int(session["total_records"])

    if total_packets > 0:
        botnet_ratio = botnet_packets / total_packets
    else:
        botnet_ratio = 0.0

    if total_records > 0:
        avg_probability = (
            session["probability_sum"] / total_records
        )
    else:
        avg_probability = 0.0

    duration = max(
        0.0,
        session["last_seen_monotonic"]
        - session["first_seen_monotonic"],
    )

    # --------------------------------------------------------
    # Target domain summary
    # --------------------------------------------------------

    domain_counts = session["domain_packet_counts"]
    ordered_domains = sorted(
        domain_counts,
        key=lambda item: (-domain_counts[item], item),
    )

    if ordered_domains:
        result["domain"] = ordered_domains[0]
    else:
        result["domain"] = None

    # domain_source is used internally during correlation, but the final
    # alert intentionally adds only the domain field. Existing Filebeat
    # host/agent metadata remains untouched for backend Agent resolution.
    result.pop("domain_source", None)

    # --------------------------------------------------------
    # Final classification
    # --------------------------------------------------------

    result["prediction"] = "BOTNET"
    result["confirmation_status"] = "CONFIRMED"
    result["session_status"] = "CLOSED"
    result["session_close_reason"] = reason

    # --------------------------------------------------------
    # Time information
    # --------------------------------------------------------

    result["first_seen_utc"] = session["first_seen_utc"]
    result["confirmed_at_utc"] = session["confirmed_at_utc"]
    result["last_seen_utc"] = session["last_seen_utc"]

    result["attack_duration_seconds"] = round(
        duration,
        3,
    )

    # --------------------------------------------------------
    # Confirmation rule information
    # --------------------------------------------------------

    result["packets_at_confirmation"] = int(
        session["packets_at_confirmation"]
    )

    result["records_at_confirmation"] = int(
        session["records_at_confirmation"]
    )

    result["rule_packet_threshold"] = BOTNET_PACKET_THRESHOLD
    result["rule_window_seconds"] = BOTNET_PACKET_WINDOW_SECONDS

    # Keep the original rule semantics.
    result["rule_packets"] = int(
        session["packets_at_confirmation"]
    )

    result["rule_records"] = int(
        session["records_at_confirmation"]
    )

    result["rule_hits"] = int(
        session["packets_at_confirmation"]
    )

    result["rule_min_hits"] = BOTNET_PACKET_THRESHOLD

    # --------------------------------------------------------
    # Final complete session statistics
    # --------------------------------------------------------

    result["total_observed_packets"] = total_packets

    result["botnet_packets"] = botnet_packets
    result["normal_packets"] = normal_packets

    result["botnet_ratio"] = round(
        botnet_ratio,
        6,
    )

    result["total_records"] = total_records

    result["botnet_records"] = int(
        session["botnet_records"]
    )

    result["normal_records"] = int(
        session["normal_records"]
    )

    # --------------------------------------------------------
    # Traffic bytes
    # --------------------------------------------------------

    result["total_observed_bytes"] = int(
        session["total_observed_bytes"]
    )

    result["botnet_traffic_bytes"] = int(
        session["botnet_traffic_bytes"]
    )

    result["normal_traffic_bytes"] = int(
        session["normal_traffic_bytes"]
    )

    # Existing dashboard compatibility.
    result["total_traffic_bytes"] = int(
        session["total_observed_bytes"]
    )

    result["traffic_bytes"] = int(
        session["total_observed_bytes"]
    )

    # --------------------------------------------------------
    # RF confidence statistics
    # --------------------------------------------------------

    result["max_botnet_probability"] = round(
        session["max_botnet_probability"],
        8,
    )

    result["avg_rf_probability"] = round(
        avg_probability,
        8,
    )

    # Existing dashboard confidence field.
    result["botnet_probability"] = round(
        session["max_botnet_probability"],
        8,
    )

    result["alert_policy"] = (
        "rf_positive_attack_session"
    )

    # --------------------------------------------------------
    # ONLY HERE is the final session written.
    # Filebeat will then forward it to Elasticsearch/dashboard.
    # --------------------------------------------------------

    write_json_line(ALERT_LOG, result)

    print(
        "[BOTNET][SESSION-CLOSED]",
        f"{result.get('src_ip')} -> "
        f"{result.get('dst_ip')}:{result.get('dst_port')}",
        f"TOTAL={total_packets}",
        f"BOTNET={botnet_packets}",
        f"NORMAL={normal_packets}",
        f"RATIO={botnet_ratio:.2%}",
        f"DOMAIN={result.get('domain') or '-'}",
        f"DURATION={duration:.3f}s",
        f"REASON={reason}",
        flush=True,
    )


def flush_attack_sessions():
    """
    Close sessions when:
      1. no matching traffic has been seen for ATTACK_IDLE_TIMEOUT, or
      2. the session reaches ATTACK_MAX_DURATION.
    """

    now = time.time()

    for key, session in list(ATTACK_SESSIONS.items()):

        idle_time = (
            now - session["last_seen_monotonic"]
        )

        session_age = (
            now - session["first_seen_monotonic"]
        )

        if idle_time >= ATTACK_IDLE_TIMEOUT:

            close_attack_session(
                key,
                "idle_timeout",
            )

        elif session_age >= ATTACK_MAX_DURATION:

            close_attack_session(
                key,
                "max_duration",
            )

def process_line(line):
    line = line.strip()
    if not line:
        return

    try:
        record = json.loads(line)
    except json.JSONDecodeError as exc:
        print("[JSON ERROR]", exc, file=sys.stderr, flush=True)
        return

    # Known infrastructure services are excluded before ML inference.
    if is_ignored_connection(record):
        return

    try:
        # Stage 1:
        # Random Forest prediction remains unchanged.
        result = predict_connection(record)

        # Resolve the original client IP from X-Forwarded-For
        # when the direct peer is a configured trusted proxy.
        result = enrich_source(record, result)

        # Correlate the target website from Zeek using the same UID.
        result = enrich_domain(record, result)

    except Exception as exc:
        print("[PREDICTION ERROR]", repr(exc), file=sys.stderr, flush=True)
        return

    # Keep ALL predictions for forensic analysis and research,
    # including NORMAL and unconfirmed RF-positive observations.
    # Confirmed-only storage: intermediate predictions are not persisted.

    # IMPORTANT:
    # NORMAL observations are NOT discarded here.
    # They are still part of the traffic session and remain counted
    # separately from BOTNET observations.

    # Never identify the trusted reverse proxy itself as the attacker.
    # If the original client IP cannot be resolved, do not create an
    # attack session using the trusted proxy address as the attacker.
    if (
        result.get("src_ip") in TRUSTED_PROXIES
        and result.get("source_ip_source") != "x_forwarded_for"
    ):
        result["source_ip_source"] = "trusted_proxy_unresolved"

        print(
            "[BOTNET][PROXY-UNRESOLVED]",
            f"{result.get('src_ip')}:{result.get('src_port')}",
            "->",
            f"{result.get('dst_ip')}:{result.get('dst_port')}",
            f"P={result.get('botnet_probability', 0):.6f}",
            "original-client-ip=unavailable",
            flush=True,
        )
        return

    # The production alert pipeline is limited to inbound web traffic
    # directed to the protected server.
    dst_ip = str(result.get("dst_ip") or "")
    dst_port = safe_int(result.get("dst_port"), 0)

    if dst_ip not in WEB_DESTINATIONS or dst_port not in WEB_PORTS:
        print(
            "[BOTNET][NON-WEB-SKIPPED]",
            f"{result.get('src_ip')}:{result.get('src_port')}",
            "->",
            f"{dst_ip}:{dst_port}",
            f"P={result.get('botnet_probability', 0):.6f}",
            flush=True,
        )
        return

    # Stage 2:
    # Every inbound web observation has already passed through RF.
    # BOTH BOTNET and NORMAL records now enter session tracking.
    session, session_status, window_packets, window_records = (
        update_attack_session(result)
    )

    if session is None:
        return

    # RF-positive observation.
    if result["prediction"] == "BOTNET":

        if session_status == "confirmed_now":

            print(
                "[BOTNET][CONFIRMED-TRACKING]",
                f"{result.get('src_ip')}:{result.get('src_port')}",
                "->",
                f"{result.get('dst_ip')}:{result.get('dst_port')}",
                f"P={result.get('botnet_probability', 0):.6f}",
                f"WINDOW_PACKETS={window_packets}",
                f"THRESHOLD={BOTNET_PACKET_THRESHOLD}",
                f"RECORDS={window_records}",
                "waiting-for-session-end",
                flush=True,
            )

        elif not session["confirmed"]:

            print(
                "[BOTNET][PENDING]",
                f"{result.get('src_ip')}:{result.get('src_port')}",
                "->",
                f"{result.get('dst_ip')}:{result.get('dst_port')}",
                f"P={result.get('botnet_probability', 0):.6f}",
                f"ORIG_PKTS={result.get('orig_pkts')}",
                f"PACKETS={window_packets}/"
                f"{BOTNET_PACKET_THRESHOLD}",
                f"RECORDS={window_records}",
                flush=True,
            )

        else:

            print(
                "[BOTNET][SESSION-ACTIVE]",
                f"{result.get('src_ip')}:{result.get('src_port')}",
                "->",
                f"{result.get('dst_ip')}:{result.get('dst_port')}",
                f"P={result.get('botnet_probability', 0):.6f}",
                f"BOTNET_PACKETS={session['botnet_packets']}",
                f"NORMAL_PACKETS={session['normal_packets']}",
                f"TOTAL_PACKETS={session['total_observed_packets']}",
                flush=True,
            )

def follow_conn_log(path, from_start=False):
    handle = None
    current_inode = None
    first_open = True
    waiting_printed = False

    while True:
        if not path.exists():
            if handle is not None:
                try:
                    handle.close()
                except Exception:
                    pass
                handle = None
                current_inode = None
            if not waiting_printed:
                print("[WAIT] conn.log not available:", path, flush=True)
                waiting_printed = True
            time.sleep(1.0)
            continue

        waiting_printed = False
        try:
            stat = path.stat()
        except OSError:
            time.sleep(POLL_INTERVAL)
            continue

        if handle is None or current_inode != stat.st_ino:
            rotated = handle is not None and current_inode != stat.st_ino
            if handle is not None:
                try:
                    handle.close()
                except Exception:
                    pass
            handle = path.open("r", encoding="utf-8", errors="replace")
            current_inode = os.fstat(handle.fileno()).st_ino
            if first_open and not from_start:
                handle.seek(0, os.SEEK_END)
            first_open = False
            print("[OPEN]", path, "inode=", current_inode, "rotated=" + str(rotated), flush=True)

        line = handle.readline()
        if line:
            process_line(line)

            # Also enforce maximum session duration while traffic continues.
            flush_attack_sessions()

            continue

        try:
            if path.stat().st_size < handle.tell():
                handle.close()
                handle = None
                current_inode = None
                continue
        except OSError:
            pass

        # No new conn.log line:
        # check whether a confirmed attack session has become idle.
        flush_attack_sessions()

        time.sleep(POLL_INTERVAL)


